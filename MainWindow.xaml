<Window x:Class="PackagingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="包装端 - 校园直播导播协调系统" Height="650" Width="850"
        Background="#1a1a2e" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#16213e" Padding="20,0">
            <Grid>
                <TextBlock Text="包装端" FontSize="20" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Red" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="连接中..." Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 当前指令区 -->
        <Border Grid.Row="1" Background="#0f3460" Margin="16,10,16,5" Padding="16" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="当前指令" FontSize="14" Foreground="#888" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" x:Name="CurrentInstruction"
                           Text="等待导播指令..." FontSize="42" FontWeight="Bold"
                           Foreground="#4ecca3" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 消息日志区 -->
        <Border Grid.Row="2" Background="#16213e" Margin="16,5,16,5" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="消息日志" FontSize="14" Foreground="#888" Margin="12,8,0,4"/>
                <ListBox Grid.Row="1" x:Name="MessageLog" Background="Transparent"
                         BorderThickness="0" Foreground="White" FontSize="13"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="12,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- 项目切换指令区 -->
        <Border Grid.Row="3" Background="#0f3460" Margin="16,5,16,5" Padding="12" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="项目切换:" Foreground="#aaa" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" x:Name="ProjectSwitchInfo"
                           Text="无" Foreground="White" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="4" Background="#16213e" Margin="16,5,16,10" Padding="12" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="LastUpdateText" Text="等待连接..."
                           Foreground="#666" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" x:Name="InterviewStatusText" Text=""
                           Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="2" Text="校园直播导播协调系统 v1.0"
                           Foreground="#444" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
